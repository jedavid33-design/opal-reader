Content-Disposition: form-data; name="v2/generation/gen-schema.mjs"; filename="v2/generation/gen-schema.mjs"
Content-Type: application/javascript+module

// D6 WS-1 — generation-plane schema (CONTRACTS.md
// "generation/gen-schema.mjs"). All tables are additive (IF NOT
// EXISTS) and live in the coordinator's Durable Object SQLite store,
// alongside — never altering — the v2 coordinator tables.
//
// CORRECTION (Rowan source-review block 6501450683): this DDL is the
// continuity-preserving schema evolution for the EXISTING
// production coordinator instance. It is invoked from the D6
// entry's OpalReaderCoordinatorProd constructor (the same class
// name/namespace the live script binds), so the d6_* tables appear
// IN PLACE inside the account instance's persisted SQLite store on
// the first D6 wake — no new DO class, no migration, no state
// carry. The bootstrap is DDL-only (no reads at all, hence no
// `.one()` empty-result hazard against real DO SQLite semantics)
// and idempotent: every later wake re-runs it as a no-op.
//
// CORRECTION 2 (arming sub-step 0 finding): the first such column
// evolution, exactly as prescribed above — guarded, idempotent
// ALTERs beside the DDL, never a table rebuild. d6_storage_state
// gains object_count / seeded_at / provenance_json for the storage
// seed (genstore.seedStorageBase). Stores created by the deployed
// build carry the original 3-column table (the D6 worker IS
// deployed, halted — the earlier "never deployed" premise no
// longer holds for the tables themselves); the CREATE below
// carries the full column set for fresh stores, and
// ensureGenSchema applies the ALTERs to pre-existing tables,
// swallowing only the duplicate-column outcome that proves a
// column is already present. Rows and values are never touched.
//
// Vocabulary (Amendment A-1, Rowan clarification 1 / Q5): reserved
// grants are not spend; attempted calls are recorded in the
// append-only attempt log at attempt time; only actual KNOWN cost
// settles against a phase budget; an UNKNOWN billing outcome halts
// its phase pending reconciliation.

export const GEN_SCHEMA = `
CREATE TABLE IF NOT EXISTS d6_plans (
  plan_id TEXT PRIMARY KEY, intent_key TEXT UNIQUE NOT NULL,
  book_id TEXT, scope TEXT, keep_going INTEGER NOT NULL DEFAULT 0,
  phase TEXT, lane TEXT, state TEXT NOT NULL, stop_reason TEXT,
  eligible_digest TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS d6_plan_jobs (
  plan_id TEXT NOT NULL, job_id TEXT NOT NULL, chapter_index INTEGER,
  seq INTEGER NOT NULL, PRIMARY KEY (plan_id, job_id));
CREATE TABLE IF NOT EXISTS d6_plan_entries (
  plan_id TEXT NOT NULL, occurrence_id TEXT NOT NULL,
  book_id TEXT, chapter_id TEXT, chapter_index INTEGER, position INTEGER,
  pov_key TEXT, char_count INTEGER, upper_micro_cents INTEGER,
  disposition TEXT, job_id TEXT,
  PRIMARY KEY (plan_id, occurrence_id));
CREATE TABLE IF NOT EXISTS d6_execution_records (
  execution_id TEXT PRIMARY KEY, plan_id TEXT, job_id TEXT NOT NULL,
  occurrence_id TEXT NOT NULL, grant_id TEXT, state TEXT NOT NULL,
  stage TEXT, cache_key TEXT, object_key TEXT, etag TEXT,
  size_bytes INTEGER, sha256 TEXT, detail_json TEXT,
  created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS d6_attempt_log (
  attempt_id TEXT PRIMARY KEY, execution_id TEXT NOT NULL,
  plan_id TEXT, occurrence_id TEXT NOT NULL, seq INTEGER NOT NULL,
  phase TEXT NOT NULL, outcome TEXT, cost_micro_cents INTEGER,
  upper_micro_cents INTEGER, provider_request_id TEXT, detail_json TEXT,
  created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS d6_phase_state (
  phase TEXT PRIMARY KEY, halted_unknown_billing INTEGER NOT NULL DEFAULT 0,
  halt_detail TEXT, updated_at INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS d6_storage_state (
  id INTEGER PRIMARY KEY CHECK (id = 1), base_bytes INTEGER NOT NULL,
  object_count INTEGER, seeded_at INTEGER, provenance_json TEXT,
  updated_at INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS d6_voice_prompts (
  plan_id TEXT NOT NULL, occurrence_id TEXT NOT NULL,
  character_name TEXT, provider TEXT, recorded_mapping TEXT,
  created_at INTEGER NOT NULL, PRIMARY KEY (plan_id, occurrence_id));
`;

// CORRECTION 2 — the guarded column evolution for d6_storage_state
// (see the header). Each ALTER is attempted unconditionally after
// the DDL; the ONLY swallowed failure is SQLite's duplicate-column
// error, which is the proof the column already exists (fresh stores
// are born with the full column set via the CREATE above). Any
// other failure rethrows — a half-evolved table must stay loud.
// Read-free, like the rest of the bootstrap: no `.one()` hazard.
const STORAGE_STATE_EVOLUTION = Object.freeze([
  ["object_count", "INTEGER"],
  ["seeded_at", "INTEGER"],
  ["provenance_json", "TEXT"],
]);

// ensureGenSchema(sql): run the DDL against a coordinator-shaped SQL
// facade (anything with .exec(query) accepting a multi-statement
// batch — the DO storage facade and the test harness both do), then
// apply the guarded column evolution.
export function ensureGenSchema(sql) {
  sql.exec(GEN_SCHEMA);
  for (const [column, type] of STORAGE_STATE_EVOLUTION) {
    try {
      sql.exec(`ALTER TABLE d6_storage_state ADD COLUMN ${column} ${type}`);
    } catch (e) {
      if (!/duplicate column/i.test(String((e && e.message) || e))) throw e;
    }
  }
}

------opalreader-d6-actual-envelope-proof
Content-Disposition: form-data; name="v2/generation/genstore.mjs"; filename="v2/generation/genstore.mjs"
Content-Type: application/javascript+module

// D6 WS-1 — the generation store (CONTRACTS.md
// "generation/genstore.mjs"). Durable per-occurrence execution
// records, the append-only attempt log, phase accounting, and the
// atomic verified commit — all inside the coordinator's store, all
// through the coordinator's own SQL/transaction helpers so a commit
// here is atomic with the binding and occurrence writes it wraps.
//
// Attempt phases (reserved → dispatching → confirmed | released):
// a `reserved` attempt has NOT dispatched and is not spend and not a
// call; `markDispatching` is the ONLY path that may precede a
// provider call; a `released` row (outcome NULL, cost 0) provably
// never dispatched. Rows are never deleted.
import { randomUUID } from "node:crypto";
import { ensureGenSchema } from "./gen-schema.mjs";

export const EXECUTION_STATES = Object.freeze([
  "granted", "attempted", "synthesized", "flushed", "verified",
  "committed", "failed", "unknown_billing",
]);
export const EXECUTION_TERMINAL_STATES = Object.freeze(["committed", "failed"]);

// The execution state machine: the linear happy path plus, from any
// non-terminal state, the two failure exits. Anything else throws.
const EXEC_TRANSITIONS = Object.freeze({
  granted: ["attempted", "failed", "unknown_billing"],
  attempted: ["synthesized", "failed", "unknown_billing"],
  synthesized: ["flushed", "failed", "unknown_billing"],
  flushed: ["verified", "failed", "unknown_billing"],
  verified: ["committed", "failed", "unknown_billing"],
  unknown_billing: ["failed"],
  committed: [],
  failed: [],
});

export const ATTEMPT_OUTCOMES = Object.freeze([
  "success", "failed_known", "policy_block", "unknown",
]);
const KNOWN_OUTCOMES = Object.freeze(["success", "failed_known", "policy_block"]);

export function createGenStore(coord) {
  if (!coord || !coord.sql) throw new Error("createGenStore requires a coordinator");
  const sql = coord.sql;
  const now = () => coord._now();

  // The full bootstrap (DDL + the guarded column evolution) lives
  // in gen-schema.mjs so every path that ensures the schema — the
  // D6 entry constructor and this store — evolves the tables the
  // same way.
  function ensureSchema() { ensureGenSchema(sql); }

  function executionRow(executionId) {
    return coord._oneOrNull(
      `SELECT * FROM d6_execution_records WHERE execution_id = ?`, executionId);
  }

  // If a non-terminal execution exists for (job_id, occurrence_id),
  // return it with created:false — never a second live execution
  // (unknown_billing counts as non-terminal here: it must be
  // reconciled, never bypassed by a fresh execution).
  function createExecution({ planId = null, jobId, occurrenceId, grantId = null }) {
    const live = coord._oneOrNull(
      `SELECT * FROM d6_execution_records
        WHERE job_id = ? AND occurrence_id = ? AND state NOT IN ('committed', 'failed')
        ORDER BY created_at DESC, execution_id DESC LIMIT 1`, jobId, occurrenceId);
    if (live) return { executionId: live.execution_id, created: false, execution: live };
    const executionId = `exec-${randomUUID()}`;
    const t = now();
    sql.exec(
      `INSERT INTO d6_execution_records
         (execution_id, plan_id, job_id, occurrence_id, grant_id, state, created_at, updated_at)
       VALUES (?, ?, ?, ?, ?, 'granted', ?, ?)`,
      executionId, planId, jobId, occurrenceId, grantId, t, t);
    return { executionId, created: true, execution: executionRow(executionId) };
  }

  // Latest execution record for (jobId, occurrenceId), or null.
  function executionFor(jobId, occurrenceId) {
    return coord._oneOrNull(
      `SELECT * FROM d6_execution_records
        WHERE job_id = ? AND occurrence_id = ?
        ORDER BY created_at DESC, execution_id DESC LIMIT 1`, jobId, occurrenceId);
  }

  // Validated state transition. `detail` may carry record fields
  // (stage, cacheKey, objectKey, etag, sizeBytes, sha256); any other
  // keys are merged into detail_json.
  function transitionExecution(executionId, to, detail = null) {
    const row = executionRow(executionId);
    if (!row) throw new Error(`execution_not_found: ${executionId}`);
    const allowed = EXEC_TRANSITIONS[row.state] || [];
    if (!allowed.includes(to))
      throw new Error(`illegal_execution_transition: ${row.state} -> ${to} (${executionId})`);
    const d = detail || {};
    const merged = { ...(row.detail_json ? JSON.parse(row.detail_json) : {}), ...d };
    sql.exec(
      `UPDATE d6_execution_records
          SET state = ?, stage = ?, cache_key = ?, object_key = ?, etag = ?,
              size_bytes = ?, sha256 = ?, detail_json = ?, updated_at = ?
        WHERE execution_id = ?`,
      to,
      d.stage !== undefined ? d.stage : row.stage,
      d.cacheKey !== undefined ? d.cacheKey : row.cache_key,
      d.objectKey !== undefined ? d.objectKey : row.object_key,
      d.etag !== undefined ? d.etag : row.etag,
      d.sizeBytes !== undefined ? d.sizeBytes : row.size_bytes,
      d.sha256 !== undefined ? d.sha256 : row.sha256,
      Object.keys(merged).length ? JSON.stringify(merged) : row.detail_json,
      now(), executionId);
    return executionRow(executionId);
  }

  function failExecution(executionId, stage, detail = null) {
    const row = executionRow(executionId);
    if (!row) throw new Error(`execution_not_found: ${executionId}`);
    if (row.state === "failed") return row;
    return transitionExecution(executionId, "failed", { ...(detail || {}), stage });
  }

  // ---- attempt log -------------------------------------------------

  function attemptRow(attemptId) {
    return coord._oneOrNull(`SELECT * FROM d6_attempt_log WHERE attempt_id = ?`, attemptId);
  }

  // Reserve an attempt (phase reserved): recorded BEFORE any
  // dispatch; a reservation is not a call and not spend.
  function reserveAttempt(executionId, { upperMicroCents } = {}) {
    const exec = executionRow(executionId);
    if (!exec) throw new Error(`execution_not_found: ${executionId}`);
    if (EXECUTION_TERMINAL_STATES.includes(exec.state))
      throw new Error(`execution_terminal: ${exec.state} (${executionId})`);
    const seqRow = coord._one(
      `SELECT COALESCE(MAX(seq), 0) AS m FROM d6_attempt_log WHERE execution_id = ?`,
      executionId);
    const attemptId = `att-${randomUUID()}`;
    const t = now();
    sql.exec(
      `INSERT INTO d6_attempt_log
         (attempt_id, execution_id, plan_id, occurrence_id, seq, phase,
          outcome, cost_micro_cents, upper_micro_cents, created_at, updated_at)
       VALUES (?, ?, ?, ?, ?, 'reserved', NULL, NULL, ?, ?, ?)`,
      attemptId, executionId, exec.plan_id, exec.occurrence_id,
      (seqRow ? seqRow.m : 0) + 1, upperMicroCents ?? 0, t, t);
    return attemptId;
  }

  // reserved -> dispatching. The ONLY path that may precede a
  // provider call.
  function markDispatching(attemptId) {
    const row = attemptRow(attemptId);
    if (!row) throw new Error(`attempt_not_found: ${attemptId}`);
    if (row.phase !== "reserved")
      throw new Error(`illegal_attempt_transition: ${row.phase} -> dispatching (${attemptId})`);
    sql.exec(`UPDATE d6_attempt_log SET phase = 'dispatching', updated_at = ? WHERE attempt_id = ?`,
      now(), attemptId);
    return attemptRow(attemptId);
  }

  // dispatching -> confirmed. Known outcomes (success | failed_known
  // | policy_block) MUST carry a numeric cost; outcome `unknown`
  // MUST carry cost null — an unknown outcome is never treated as
  // free and never silently zeroed.
  function confirmAttempt(attemptId, { outcome, costMicroCents = null, providerRequestId = null } = {}) {
    const row = attemptRow(attemptId);
    if (!row) throw new Error(`attempt_not_found: ${attemptId}`);
    if (row.phase !== "dispatching")
      throw new Error(`illegal_attempt_transition: ${row.phase} -> confirmed (${attemptId})`);
    if (!ATTEMPT_OUTCOMES.includes(outcome))
      throw new Error(`attempt_outcome_invalid: ${outcome}`);
    if (KNOWN_OUTCOMES.includes(outcome) && typeof costMicroCents !== "number")
      throw new Error(`attempt_cost_required_for_known_outcome: ${outcome}`);
    if (outcome === "unknown" && costMicroCents !== null)
      throw new Error("attempt_cost_must_be_null_for_unknown_outcome");
    sql.exec(
      `UPDATE d6_attempt_log
          SET phase = 'confirmed', outcome = ?, cost_micro_cents = ?,
              provider_request_id = ?, updated_at = ?
        WHERE attempt_id = ?`,
      outcome, costMicroCents, providerRequestId, now(), attemptId);
    return attemptRow(attemptId);
  }

  // reserved -> released: the attempt provably never dispatched
  // (outcome stays NULL, cost is set to 0 — it counts as NO call in
  // every accounting view).
  function releaseAttempt(attemptId) {
    const row = attemptRow(attemptId);
    if (!row) throw new Error(`attempt_not_found: ${attemptId}`);
    if (row.phase !== "reserved")
      throw new Error(`illegal_attempt_transition: ${row.phase} -> released (${attemptId})`);
    sql.exec(
      `UPDATE d6_attempt_log SET phase = 'released', cost_micro_cents = 0, updated_at = ?
        WHERE attempt_id = ?`, now(), attemptId);
    return attemptRow(attemptId);
  }

  function attemptsForOccurrence(planId, occurrenceId) {
    return coord._all(
      `SELECT * FROM d6_attempt_log WHERE plan_id = ? AND occurrence_id = ?
        ORDER BY created_at, seq`, planId, occurrenceId);
  }

  function attemptsForExecution(executionId) {
    return coord._all(
      `SELECT * FROM d6_attempt_log WHERE execution_id = ? ORDER BY seq`, executionId);
  }

  // Attempts that count toward the 12-attempt segment budget:
  // dispatching + confirmed. Reserved and released do NOT count —
  // they provably never became provider calls.
  function segmentAttemptsUsed(planId, occurrenceId) {
    return coord._one(
      `SELECT COUNT(*) AS n FROM d6_attempt_log
        WHERE plan_id = ? AND occurrence_id = ? AND phase IN ('dispatching', 'confirmed')`,
      planId, occurrenceId).n;
  }

  // ---- the atomic verified commit ----------------------------------
  // Runs INSIDE coord._tx: (1) coord.validateAndBind (a bound:false
  // verdict aborts by throwing — nothing commits), (2) the
  // occurrence's cache_key update + report_success event, (3) the
  // execution record -> committed. All-or-nothing. Idempotent on
  // (occurrenceId, executionId): re-committing a committed execution
  // is a no-op return.
  function commitVerified({ executionId, jobId, occurrenceId, revisionKey,
                            cacheKey, sha256 = null, provenance = null }) {
    return coord._tx(() => {
      const exec = executionRow(executionId);
      if (!exec) throw new Error(`execution_not_found: ${executionId}`);
      if (exec.state === "committed") return { bound: true, idempotent: true };
      if (exec.state !== "verified")
        throw new Error(`commit_requires_verified_execution: ${exec.state} (${executionId})`);
      const v = coord.validateAndBind({
        occurrenceId, revisionKey, cacheKey,
        provenance: provenance ?? `d6:${executionId}`,
        jobId, expectedSha256: sha256,
      });
      if (!v.bound) {
        const err = new Error(`commit_validate_failed: ${v.reason}`);
        err.reason = v.reason;
        throw err;
      }
      const occ = coord._oneOrNull(
        `SELECT * FROM occurrences WHERE job_id = ? AND occurrence_id = ?`,
        jobId, occurrenceId);
      if (!occ) throw new Error(`occurrence_not_found: ${jobId}/${occurrenceId}`);
      sql.exec(`UPDATE occurrences SET cache_key = ? WHERE job_id = ? AND occurrence_id = ?`,
        cacheKey, jobId, occurrenceId);
      if (occ.state === "granted") {
        const r = coord.applyOccEvent(jobId, occurrenceId, "report_success",
          "d6_commit", { executionId });
        if (!r.ok) throw new Error(`commit_occurrence_transition_failed: ${r.reason}`);
      } else if (occ.state !== "ready") {
        throw new Error(`commit_occurrence_state_unexpected: ${occ.state}`);
      }
      transitionExecution(executionId, "committed", { cacheKey, sha256 });
      return { bound: true };
    });
  }

  // ---- unknown billing: phase halt + reconciliation -----------------

  // Execution -> unknown_billing AND the plan's phase halt, in the
  // SAME transaction: there is no state in which the execution is
  // marked unknown but the phase can still grant.
  function markUnknownBilling(executionId, detail = null) {
    return coord._tx(() => {
      const exec = transitionExecution(executionId, "unknown_billing",
        detail && typeof detail === "object" ? detail : { detail });
      if (exec.plan_id) {
        const plan = coord._oneOrNull(
          `SELECT * FROM d6_plans WHERE plan_id = ?`, exec.plan_id);
        if (plan && plan.phase) {
          sql.exec(
            `INSERT INTO d6_phase_state (phase, halted_unknown_billing, halt_detail, updated_at)
             VALUES (?, 1, ?, ?)
             ON CONFLICT(phase) DO UPDATE SET halted_unknown_billing = 1,
               halt_detail = excluded.halt_detail, updated_at = excluded.updated_at`,
            plan.phase, JSON.stringify(detail ?? null), now());
        }
      }
      return exec;
    });
  }

  function phaseAccounting(phase) {
    const settled = coord._one(
      `SELECT COALESCE(SUM(a.cost_micro_cents), 0) AS s FROM d6_attempt_log a
        WHERE a.outcome IN ('success', 'failed_known', 'policy_block')
          AND a.phase = 'confirmed'
          AND a.plan_id IN (SELECT plan_id FROM d6_plans WHERE phase = ?)`, phase);
    const inFlight = coord._one(
      `SELECT COALESCE(SUM(a.upper_micro_cents), 0) AS s FROM d6_attempt_log a
        WHERE a.phase IN ('reserved', 'dispatching')
          AND a.plan_id IN (SELECT plan_id FROM d6_plans WHERE phase = ?)`, phase);
    const unknown = coord._one(
      `SELECT COUNT(*) AS n FROM d6_attempt_log a
        WHERE a.phase = 'confirmed' AND a.outcome = 'unknown'
          AND a.plan_id IN (SELECT plan_id FROM d6_plans WHERE phase = ?)`, phase);
    return {
      settledMicro: settled.s,
      inFlightUpperMicro: inFlight.s,
      unknownOpen: unknown.n,
    };
  }

  // Operator reconciliation mechanism for one unknown attempt:
  // { knownCostMicro: <number>, outcome? } records the now-known
  // cost under a known outcome (default: "success" when a cost is
  // supplied — the caller may pass outcome "failed_known" for a
  // charged-but-failed call); { knownCostMicro: null } records a
  // proven no-charge as failed_known with cost 0. When no unknown
  // attempts remain open for the attempt's phase, the phase halt
  // clears in the same transaction.
  function reconcileUnknown(attemptId, { knownCostMicro = null, outcome = null } = {}) {
    return coord._tx(() => {
      const row = attemptRow(attemptId);
      if (!row) throw new Error(`attempt_not_found: ${attemptId}`);
      if (!(row.phase === "confirmed" && row.outcome === "unknown"))
        throw new Error(`attempt_not_unknown: ${attemptId} (${row.phase}/${row.outcome})`);
      let finalOutcome, finalCost;
      if (knownCostMicro === null || knownCostMicro === undefined) {
        finalOutcome = outcome || "failed_known";
        finalCost = 0;
      } else {
        if (typeof knownCostMicro !== "number")
          throw new Error("reconcile_cost_must_be_number_or_null");
        finalOutcome = outcome || "success";
        finalCost = knownCostMicro;
      }
      if (!KNOWN_OUTCOMES.includes(finalOutcome))
        throw new Error(`reconcile_outcome_invalid: ${finalOutcome}`);
      sql.exec(
        `UPDATE d6_attempt_log SET outcome = ?, cost_micro_cents = ?, updated_at = ?
          WHERE attempt_id = ?`, finalOutcome, finalCost, now(), attemptId);
      // Clear the phase halt when this was the phase's last open
      // unknown.
      let haltCleared = false;
      if (row.plan_id) {
        const plan = coord._oneOrNull(
          `SELECT * FROM d6_plans WHERE plan_id = ?`, row.plan_id);
        if (plan && plan.phase) {
          const acct = phaseAccounting(plan.phase);
          if (acct.unknownOpen === 0) {
            sql.exec(
              `UPDATE d6_phase_state SET halted_unknown_billing = 0,
                 halt_detail = NULL, updated_at = ? WHERE phase = ?`,
              now(), plan.phase);
            haltCleared = true;
          }
        }
      }
      return { attempt: attemptRow(attemptId), haltCleared };
    });
  }

  // ---- storage accounting -------------------------------------------
  // baseBytes: the bucket's pre-D6 usage, seeded by the operator
  // from the verified account listing (PINS.md §3). d6Bytes: bytes
  // D6 itself has durably flushed (execution records in
  // flushed | verified | committed).
  function storageAccounting() {
    const base = coord._oneOrNull(`SELECT * FROM d6_storage_state WHERE id = 1`);
    const d6 = coord._one(
      `SELECT COALESCE(SUM(size_bytes), 0) AS s FROM d6_execution_records
        WHERE state IN ('flushed', 'verified', 'committed')`);
    return { baseBytes: base ? base.base_bytes : 0, d6Bytes: d6.s };
  }

  function setStorageBaseBytes(baseBytes) {
    sql.exec(
      `INSERT INTO d6_storage_state (id, base_bytes, updated_at) VALUES (1, ?, ?)
       ON CONFLICT(id) DO UPDATE SET base_bytes = excluded.base_bytes,
         updated_at = excluded.updated_at`, baseBytes, now());
    return storageAccounting();
  }

  // ---- the storage seed (CORRECTION 2) ------------------------------
  // The production seed path for the storage guard's base. The
  // caller (the generation service's seedStorageBase, behind the
  // fenced seed route) supplies the FRESH recount figures; this
  // method is the only writer of the seed columns. Semantics:
  //   * first seed: records baseBytes + objectCount + seededAt and
  //     opens the provenance history;
  //   * re-seed with the SAME values: idempotent — nothing is
  //     written (updated_at and the history stand), reported as
  //     { changed: false, idempotent: true };
  //   * re-seed with DIFFERENT values: replaces the base and
  //     APPENDS a provenance entry carrying the previous values —
  //     a silent overwrite is impossible by construction.
  // The halt fence itself lives in the service (it owns env); this
  // method validates shape and throws on anything but non-negative
  // safe integers, so no caller can seed a nonsense base.
  function storageSeedState() {
    const row = coord._oneOrNull(`SELECT * FROM d6_storage_state WHERE id = 1`);
    if (!row) return {
      seeded: false, baseBytes: 0, objectCount: null,
      seededAt: null, provenance: [],
    };
    return {
      seeded: true,
      baseBytes: row.base_bytes,
      objectCount: row.object_count ?? null,
      seededAt: row.seeded_at ?? null,
      provenance: row.provenance_json ? JSON.parse(row.provenance_json) : [],
    };
  }

  function seedStorageBase({ baseBytes, objectCount = null,
                             recountedAt = null, source = null } = {}) {
    if (!Number.isSafeInteger(baseBytes) || baseBytes < 0)
      throw new Error("storage_seed_shape: baseBytes must be a non-negative safe integer");
    if (objectCount !== null &&
        (!Number.isSafeInteger(objectCount) || objectCount < 0))
      throw new Error("storage_seed_shape: objectCount must be null or a non-negative safe integer");
    const cur = coord._oneOrNull(`SELECT * FROM d6_storage_state WHERE id = 1`);
    if (cur && cur.base_bytes === baseBytes &&
        (cur.object_count ?? null) === objectCount)
      return { ...storageSeedState(), changed: false, idempotent: true };
    const t = now();
    const history = cur && cur.provenance_json
      ? JSON.parse(cur.provenance_json) : [];
    history.push({
      baseBytes, objectCount, seededAt: t,
      recountedAt: recountedAt ?? null, source: source ?? null,
      previous: cur ? {
        baseBytes: cur.base_bytes,
        objectCount: cur.object_count ?? null,
      } : null,
    });
    sql.exec(
      `INSERT INTO d6_storage_state
         (id, base_bytes, object_count, seeded_at, provenance_json, updated_at)
       VALUES (1, ?, ?, ?, ?, ?)
       ON CONFLICT(id) DO UPDATE SET base_bytes = excluded.base_bytes,
         object_count = excluded.object_count, seeded_at = excluded.seeded_at,
         provenance_json = excluded.provenance_json,
         updated_at = excluded.updated_at`,
      baseBytes, objectCount, t, JSON.stringify(history), t);
    return { ...storageSeedState(), changed: true, idempotent: false };
  }

  // ---- crash recovery scan -------------------------------------------
  // Classify every non-terminal execution record for the recovery
  // path (proposal §4 / FI-6). Classification only — the caller
  // (service.recover / the executor) performs the actions; R2-side
  // re-verification belongs to the executor, which owns R2.
  function recoveryScan() {
    const rows = coord._all(
      `SELECT * FROM d6_execution_records
        WHERE state NOT IN ('committed', 'failed') ORDER BY created_at, execution_id`);
    return rows.map(execution => {
      let action;
      if (execution.state === "flushed" || execution.state === "verified")
        action = "reverify_and_commit";
      else if (execution.state === "synthesized")
        action = "reenter_flush";
      else if (execution.state === "unknown_billing")
        action = "reconcile_hold";
      else { // granted | attempted
        const dispatching = coord._one(
          `SELECT COUNT(*) AS n FROM d6_attempt_log
            WHERE execution_id = ? AND phase = 'dispatching'`, execution.execution_id).n;
        action = dispatching > 0 ? "reconcile_hold" : "release_and_fail";
      }
      return { execution, action };
    });
  }

  return {
    ensureSchema,
    createExecution, executionFor, transitionExecution, failExecution,
    reserveAttempt, markDispatching, confirmAttempt, releaseAttempt,
    attemptsForOccurrence, attemptsForExecution, segmentAttemptsUsed,
    commitVerified, markUnknownBilling, phaseAccounting, reconcileUnknown,
    storageAccounting, setStorageBaseBytes, seedStorageBase, storageSeedState,
    recoveryScan,
  };
}

------opalreader-d6-actual-envelope-proof
Content-Disposition: form-data; name="v2/generation/grant-guards.mjs"; filename="v2/generation/grant-guards.mjs"
Content-Type: application/javascript+module

// D6 WS-1 — the grant guard (CONTRACTS.md "Coordinator patches" #2
// + "generation/grant-guards.mjs"). Called from
// GenerationCoordinator._issueGrant when — and only when —
// env.d6StandardOnly is on, after the existing monthly-cap check.
//
// Fail-closed discipline: a job linked to a D6 plan (d6_plan_jobs →
// d6_plans) is refused, in order, when
//   1. its phase is halted for unknown billing
//      ("phase_halted_unknown_billing"),
//   2. settled known cost + in-flight upper bounds + the upper
//      bounds of this grant's target pending occurrences would
//      exceed the phase budget ("phase_budget"), or
//   3. the storage projection (base + committed/flushed D6 bytes +
//      the plan's remaining eligible characters at the pinned rate
//      with the retries/orphans allowance) reaches the 10 GB R2
//      free-tier boundary ("storage_boundary").
// Jobs without a plan are not plan-guarded ({ ok: true }) — with
// the D7-2/D8 exceptions (below): under the production entry's
// halt fence (env.d6HaltFence), a plan-less job attempting a
// grant while GENERATION_HALT !== "0" is refused AND durably
// quarantined (D7-2), and a plan-less job born inside a recorded
// halt epoch is marked + refused on its first guarded attempt
// whenever it happens (D8-2) — so work staged by a legacy
// command while halted can never become grantable through a
// later generic re-arm, even when its halt-era attempts were
// refused before ever reaching this guard.
// If the flag is on but the d6 tables are missing, the lookups
// THROW — loud, never a silent pass (the D6 service ensures the
// schema at construction).
import { createGenStore } from "./genstore.mjs";
import {
  PHASE_BUDGET_MICRO_CENTS, BYTES_PER_CHAR,
  RETRIES_ORPHANS_ALLOWANCE, R2_FREE_TIER_BYTES,
} from "./gen-constants.mjs";
import {
  ensureQuarantineSchema, heldQuarantineStrict, quarantineHoldRow,
  recordQuarantineHold, noteHaltObservation, haltEpochSuspect,
} from "./quarantine.mjs";

export function d6PlanForJob(coord, jobId) {
  const link = coord._oneOrNull(
    `SELECT * FROM d6_plan_jobs WHERE job_id = ?`, jobId);
  if (!link) return null;
  const plan = coord._oneOrNull(
    `SELECT * FROM d6_plans WHERE plan_id = ?`, link.plan_id);
  return plan ? { link, plan } : null;
}

export function d6PhaseHalt(coord, phase) {
  if (!phase) return null;
  const row = coord._oneOrNull(
    `SELECT * FROM d6_phase_state WHERE phase = ?`, phase);
  return row && row.halted_unknown_billing ? row : null;
}

// The fail-closed storage projection for one plan (proposal §12 /
// PINS.md §3): current base usage + D6's own durable bytes + the
// plan's remaining eligible characters (eligible entries not yet
// bound) at 3,012.6 bytes/char with the ×1.10 retries/orphans
// allowance. Refuses at >= 10,000,000,000 bytes.
export function d6StorageProjection(coord, planId) {
  const store = createGenStore(coord);
  const { baseBytes, d6Bytes } = store.storageAccounting();
  const row = coord._one(
    `SELECT COALESCE(SUM(e.char_count), 0) AS chars FROM d6_plan_entries e
      WHERE e.plan_id = ? AND e.disposition = 'eligible'
        AND NOT EXISTS (SELECT 1 FROM bindings b
                         WHERE b.occurrence_id = e.occurrence_id)`, planId);
  const remainingChars = row.chars;
  const projection = baseBytes + d6Bytes +
    remainingChars * BYTES_PER_CHAR * RETRIES_ORPHANS_ALLOWANCE;
  return {
    baseBytes, d6Bytes, remainingChars, projection,
    refuses: projection >= R2_FREE_TIER_BYTES,
  };
}

export function d6GrantGuard(coord, job) {
  const jobId = job && (job.job_id ?? job.jobId);
  if (!jobId) return { ok: true };
  const found = d6PlanForJob(coord, jobId);

  // D7-2 QUARANTINE (Rowan ruling 6524426826; Julie's approval
  // 6524562842): the birth-mark fence. Evaluated FIRST — before
  // the phase/budget/storage checks — because a held subject is
  // an ABSOLUTE grant/ledger/outbox fence: no grant issues for it
  // under any phase, budget, or halt state, and NO generic act
  // clears the hold (re-arm, phase binding, settings change, plan
  // retry, a client field, another subject's release). The only
  // clearance is the operator-only per-subject release
  // (service.releaseQuarantine). The quarantine table is lazily
  // ensured HERE, after d6PlanForJob — so the fail-loud contract
  // above is untouched (a store missing the core d6 tables still
  // throws from the plan lookup before this DDL can mask it).
  //
  // D8-1 (Rowan review 6525035570): the hold reads here are
  // STRICT (heldQuarantineStrict). The D7-2 build read them
  // through a catch-all helper, so an arbitrary SELECT failure
  // masqueraded as "no hold" and the guard could continue to a
  // grant. Now the schema is ensured and any read error THROWS
  // inside _issueGrant's transaction — the grant, ledger
  // reservation, and outbox rows roll back with it. An error is
  // never "no hold" at a spending fence.
  //
  // D8-2 (same review): every guarded grant attempt also notes
  // the halt observation for the epoch ledger (quarantine.mjs) —
  // inside this same transaction, so the ledger commits or rolls
  // back with the grant decision it informs.
  ensureQuarantineSchema(coord.sql);
  noteHaltObservation(coord, coord.env);
  if (found && heldQuarantineStrict(coord, "plan", found.plan.plan_id))
    return { ok: false, reason: "plan_quarantined" };
  if (heldQuarantineStrict(coord, "job", jobId))
    return { ok: false, reason: "job_quarantined" };

  if (!found) {
    // Rowan's named hole: a plan-less job is otherwise unguarded,
    // so a legacy grant-producing command (RequestSynthesis, a
    // RequestResume probe, a repair-chain follow-up) from an old
    // client could stage spendable work while halted and have it
    // granted by a later generic re-arm. Under the production
    // entry's halt fence (env.d6HaltFence — set ONLY by
    // worker-entry-prod-d6.js's d6HostEnv; direct constructions
    // keep the exact pre-D7-2 unguarded behavior), a grant
    // attempt for a plan-less job while GENERATION_HALT !== "0"
    // (missing/malformed counts as halted) is REFUSED, and the
    // job is durably marked in the same transaction — the mark,
    // not the halt flag, is what keeps it fenced after re-arm.
    // This guard runs inside _issueGrant's transaction, so the
    // refusal and the mark commit atomically.
    if (coord.env.d6HaltFence === true &&
        coord.env.GENERATION_HALT !== "0") {
      recordQuarantineHold(coord, {
        subjectKind: "job", subjectId: jobId,
        reason: "grant_attempt_while_halted", source: "grant_guard",
      });
      return { ok: false, reason: "generation_halted" };
    }
    // D8-2 EPOCH FENCE (Rowan review 6525035570, blocker D8-2):
    // the halt-branch mark above fires only when a grant attempt
    // REACHES this guard while halted — but _issueGrant checks
    // the quota park, the daily quota, and the monthly cap BEFORE
    // this guard, so a halt-era attempt can be refused early and
    // leave the job unmarked; and an attempt that only ever
    // happens after a generic re-arm never sees the halt branch
    // at all. The halt-EPOCH ledger (quarantine.mjs) closes that
    // hole durably: a plan-less job still in its pre-grant
    // 'queued' state whose birth falls inside a recorded halt
    // epoch is marked NOW — atomically, in this transaction,
    // whenever the first guarded attempt happens — and refused
    // as quarantined. Entry admission (worker-entry-prod-d6.js)
    // refuses the client-reachable staging commands while halted
    // outright; this fence is for the rows that exist in the
    // store despite that (staged under the pre-D8 entry, or
    // written by an operator-plane path). Jobs born before the
    // epoch are never suspect; jobs in any post-grant state are
    // outside this fence (the state-independent hold fence above
    // governs held subjects). One epoch-suspect job is fenced
    // until the operator releases THAT job — never by a generic
    // re-arm. The fence adjudicates a subject's birth ONCE: a job
    // that already HAS a hold row is not re-adjudicated — a held
    // row already refused it above, and a RELEASED row is the
    // operator's completed clearance, which the epoch must never
    // silently re-impose.
    if (coord.env.d6HaltFence === true &&
        coord.env.GENERATION_HALT === "0" &&
        job && job.state === "queued" &&
        !quarantineHoldRow(coord, "job", jobId) &&
        haltEpochSuspect(coord, job.created_at)) {
      recordQuarantineHold(coord, {
        subjectKind: "job", subjectId: jobId,
        reason: "born_while_halted", source: "halt_epoch",
      });
      return { ok: false, reason: "job_quarantined" };
    }
    return { ok: true };
  }
  const { plan } = found;

  if (plan.phase) {
    if (d6PhaseHalt(coord, plan.phase))
      return { ok: false, reason: "phase_halted_unknown_billing" };
    const budget = PHASE_BUDGET_MICRO_CENTS[plan.phase];
    if (budget !== undefined) {
      const store = createGenStore(coord);
      const acct = store.phaseAccounting(plan.phase);
      // The grant's target pending occurrences: this job's eligible
      // plan entries whose occurrences are still pending.
      const pending = coord._one(
        `SELECT COALESCE(SUM(e.upper_micro_cents), 0) AS s
           FROM d6_plan_entries e
           JOIN occurrences o
             ON o.job_id = e.job_id AND o.occurrence_id = e.occurrence_id
          WHERE e.plan_id = ? AND e.job_id = ? AND e.disposition = 'eligible'
            AND o.state = 'pending'`, plan.plan_id, jobId);
      const projected = acct.settledMicro + acct.inFlightUpperMicro + pending.s;
      if (projected > budget) return { ok: false, reason: "phase_budget" };
    }
  }

  const proj = d6StorageProjection(coord, plan.plan_id);
  if (proj.refuses) return { ok: false, reason: "storage_boundary" };
  return { ok: true };
}

