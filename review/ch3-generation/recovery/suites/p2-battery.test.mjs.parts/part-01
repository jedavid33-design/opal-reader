describe("T0 — assembly & identity (fixture-parameterized)", () => {
  test("candidate tree: 31 parts; fixture changed parts differ from deployed and match fixture identities; every other part byte-identical", () => {
    const candFiles = listFiles(join(CAND, "v2"));
    const partFiles = listFiles(join(PARTS, "v2"));
    assert.equal(candFiles.length, 31);
    assert.deepEqual(candFiles, partFiles);
    let identical = 0;
    for (const rel of partFiles) {
      const a = shaFile(join(PARTS, "v2", rel));
      const b = shaFile(join(CAND, "v2", rel));
      if (CHANGED.has(rel)) {
        assert.notEqual(a, b, `${rel} must differ from deployed`);
        assert.equal(b, CHANGED.get(rel),
          `${rel} must equal the fixture identity for this tree`);
      } else {
        assert.equal(a, b, `${rel} must be byte-identical`);
        identical++;
      }
    }
    assert.equal(identical, 31 - CHANGED.size);
  });

  test("patch round-trip: each fixture diff applied to pristine parts reproduces the candidate parts byte-for-byte", () => {
    for (const rt of IDENTITY.roundTrips) {
      const tmp = mkdtempSync(join(tmpdir(), "p2-roundtrip-"));
      for (const rel of rt.files) {
        mkdirSync(join(tmp, "v2", dirname(rel)), { recursive: true });
        cpSync(join(PARTS, "v2", rel), join(tmp, "v2", rel));
      }
      execFileSync("patch", ["-s", "-p1",
        "-i", resolve(RECOVERY, rt.diff)], { cwd: tmp });
      for (const rel of rt.files)
        assert.equal(shaFile(join(tmp, "v2", rel)), CHANGED.get(rel),
          `${rel} round-trip via ${rt.diff}`);
    }
  });

  test("node --check passes on every fixture changed part (candidate tree)", () => {
    for (const rel of IDENTITY.nodeCheckParts)
      execFileSync("node", ["--check", join(CAND, "v2", rel)]);
  });

  test("baseline tree is the pristine deployed tree (31/31 byte-identical)", () => {
    for (const rel of listFiles(join(PARTS, "v2")))
      assert.equal(shaFile(join(BASE, "v2", rel)),
        shaFile(join(PARTS, "v2", rel)), rel);
  });
});

