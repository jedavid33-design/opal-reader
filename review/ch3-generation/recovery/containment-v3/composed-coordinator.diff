+CREATE TABLE IF NOT EXISTS d6_containment_state (
+  id INTEGER PRIMARY KEY CHECK (id = 1),
+  state TEXT NOT NULL,
+  updated_at INTEGER NOT NULL,
+  authorization_ref TEXT,
+  stop_status TEXT,
