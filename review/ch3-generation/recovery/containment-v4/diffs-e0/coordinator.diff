+// Read the containment state. Never throws, never writes.
+// Returns { state, known, absent, verified, updatedAt,
+// authorizationRef, stopStatus, stopVerifiedAt, stopVerifyAction,
+// stopArmedBefore, stopArmedAfter, stopVerifyAttempts, errorName }:
+//   absent=true            -> no table / no row: verified NORMAL.
+//   known=true             -> stored value is one of the enum.
+//   verified=false         -> a read failure or an unrecognized
+//                             value: consumers must default darker.
+// The stop* fields are the durable physical-stop record (design
+// v3 §2): three facts kept permanently separate — the enum (this
+// read's `state`), the last physical verification (stopVerifiedAt,
+// stopVerifyAction, stopArmedBefore/stopArmedAfter), and the
+// stop-verification status (stopStatus). stopStatus is null
+// whenever no verification has been recorded; under CHAIN_STOPPED
+// a null or 'unverified' status means the physical stop is NOT
+// verified — never infer it from the enum.
+export function readContainmentState(sql) {
+  const NO_STOP = { stopStatus: null, stopVerifiedAt: null,
+    stopVerifyAction: null, stopArmedBefore: null,
+    stopArmedAfter: null, stopVerifyAttempts: 0,
+    stopEpisodeId: null, stopEpisodeExhausted: false,
+    prevEpisodeId: null, prevEpisodeAttempts: null,
+    prevEpisodeExhausted: null, prevEpisodeClosedAt: null };
+  let rows;
+  try {
+    rows = sql.exec(
+      `SELECT state, updated_at, authorization_ref,
+              stop_status, stop_verified_at, stop_verify_action,
+              stop_armed_before, stop_armed_after, stop_verify_attempts,
+              stop_episode_id, stop_episode_exhausted,
+              prev_episode_id, prev_episode_attempts,
+              prev_episode_exhausted, prev_episode_closed_at
+         FROM d6_containment_state WHERE id = 1`).toArray();
+  } catch (e) {
+    const msg = String((e && e.message) || e);
+    if (/no such table/i.test(msg))
+      return { state: "NORMAL", known: true, absent: true,
+        verified: true, updatedAt: null, authorizationRef: null,
+        ...NO_STOP, errorName: null };
+    return { state: null, known: false, absent: false,
+      verified: false, updatedAt: null, authorizationRef: null,
+      ...NO_STOP,
+      errorName: e && e.name ? String(e.name) : "Error" };
+  }
+  if (!rows || rows.length === 0)
+    return { state: "NORMAL", known: true, absent: true,
+      verified: true, updatedAt: null, authorizationRef: null,
+      ...NO_STOP, errorName: null };
+  const r = rows[0];
+  const known = CONTAINMENT_STATES.includes(r.state);
+  const num = (v) => typeof v === "number" ? v : null;
+  const str = (v) => typeof v === "string" ? v : null;
+  return { state: r.state, known, absent: false, verified: known,
+    updatedAt: num(r.updated_at),
+    authorizationRef: str(r.authorization_ref),
+    stopStatus: CONTAINMENT_STOP_STATUSES.includes(r.stop_status)
+      ? r.stop_status : null,
+    stopVerifiedAt: num(r.stop_verified_at),
+    stopVerifyAction: str(r.stop_verify_action),
+    stopArmedBefore: num(r.stop_armed_before),
+    stopArmedAfter: num(r.stop_armed_after),
+    stopVerifyAttempts:
+      typeof r.stop_verify_attempts === "number"
+        ? r.stop_verify_attempts : 0,
+    stopEpisodeId: num(r.stop_episode_id),
+    stopEpisodeExhausted: r.stop_episode_exhausted === 1,
+    prevEpisodeId: num(r.prev_episode_id),
+    prevEpisodeAttempts: num(r.prev_episode_attempts),
+    prevEpisodeExhausted:
+      r.prev_episode_exhausted === 1 ? true
+        : r.prev_episode_exhausted === 0 ? false : null,
+    prevEpisodeClosedAt: num(r.prev_episode_closed_at),
+    errorName: null };
+}
