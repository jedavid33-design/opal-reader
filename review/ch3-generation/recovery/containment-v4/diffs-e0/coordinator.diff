+
+// Arm gate (every setAlarm path in this part): suppressed in
+// CHAIN_STOPPED, and on any unverified read that is not a
+// structurally-verified absence (absent reads verify as NORMAL,
+// above, so they never reach this branch).
+export function containmentArmSuppressed(read) {
+  if (!read) return true;
+  if (!read.verified) return true;
+  return read.state === "CHAIN_STOPPED";
