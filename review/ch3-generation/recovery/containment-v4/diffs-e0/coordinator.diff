+//     wake, or read.
+//   * RACE FIX (async analysis, centerpiece): _armAlarmIfEarlier
+//     RE-CHECKS the arm gate after its getAlarm() await, in the
+//     same synchronous stretch that initiates setAlarm(). The v2
+//     shape read the gate BEFORE the await, so a stop committed
+//     during the await was invisible to a wake already past the
+//     gate — the wake could re-register after the stop's
+//     deleteAlarm() had landed (and a null read-back — the
+//     just-deleted registration — satisfied the shipped
+//     re-arm-if-unarmed condition). The re-check makes any stop
+//     committed BEFORE the re-check visible to the wake. What
+//     stands physically when a stop commits AFTER the wake's
+//     setAlarm initiation depends on platform storage-effect
+//     ordering, which v4 does NOT claim as guaranteed (async
+//     analysis v4 §2; assumption family A-3, unresolved).
+//
+// V4 ADDENDUM (Phase B containment design v4;
+// PHASEB-CONTAINMENT-DESIGN-V4.md; Rowan containment V3 ruling,
+// required corrections R1/R3):
+//   * STOP-RECORD TRUTH (R1): read surfaces additionally derive
+//     a CURRENT PHYSICAL CONFIDENCE at read time
+//     (deriveStopConfidence below) from the stored facts PLUS a
+//     fresh getAlarm() observation supplied by the caller. The
+//     stored enum NEVER downgrades; the derived confidence is
+//     not the enum and degrades freely on later evidence — a
+//     surviving registration (contested), a failed fresh read
+//     (unknown) — WITHOUT erasing the last-successful-
+//     verification fact: stop_verified_at & friends are still
+//     written only by stop actions, exactly as in v3.
+//   * EPISODE LAW (R3): every stop_chain act mints a stop
+//     EPISODE (stop_episode_id = the id of the stop_chain audit
+//     event that opened it). Verification attempts belong to
+//     the episode; reaching MAX_STOP_VERIFY_ATTEMPTS unverified
+//     marks the episode EXHAUSTED (stop_episode_exhausted + a
+//     stop_episode_exhausted audit event) and verify_chain_stop
+//     refuses further attempts within it. A clear CLOSES the
+//     episode: its summary is copied to the prev_episode_*
+//     fields and a stop_episode_closed audit event is appended
+//     BEFORE the record resets, so an exhausted episode is
+//     never silently reset — it stays readable on every
+//     surface after the clear, and gate paperwork must
+//     disclose it (design v4 §4).
+// ------------------------------------------------------------------
+export const CONTAINMENT_STATES = Object.freeze([
+  "NORMAL", "DRIVE_CONTAINED", "CHAIN_STOPPED",
+]);
+// Stop-verification statuses recorded on the state row. 'verified'
+// is written only by stop_chain's own verified act; 're_verified'
+// only by verify_chain_stop moving an unverified (or unrecorded)
+// stop to a null read-back. Anything else — NULL included — means
+// the physical stop is NOT verified.
+export const CONTAINMENT_STOP_STATUSES = Object.freeze([
+  "verified", "unverified", "re_verified",
+]);
+// Bounded physical-verification attempts per stop episode,
+// INCLUDING stop_chain's own act (attempt 1).
+export const MAX_STOP_VERIFY_ATTEMPTS = 3;
+const CONTAINMENT_SCHEMA = `
+CREATE TABLE IF NOT EXISTS d6_containment_state (
+  id INTEGER PRIMARY KEY CHECK (id = 1),
+  state TEXT NOT NULL,
+  updated_at INTEGER NOT NULL,
+  authorization_ref TEXT,
+  stop_status TEXT,
+  stop_verified_at INTEGER,
+  stop_verify_action TEXT,
+  stop_armed_before INTEGER,
+  stop_armed_after INTEGER,
+  stop_verify_attempts INTEGER NOT NULL DEFAULT 0,
+  stop_episode_id INTEGER,
+  stop_episode_exhausted INTEGER NOT NULL DEFAULT 0,
+  prev_episode_id INTEGER,
+  prev_episode_attempts INTEGER,
+  prev_episode_exhausted INTEGER,
+  prev_episode_closed_at INTEGER
