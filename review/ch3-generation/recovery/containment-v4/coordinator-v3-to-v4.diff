+// CONTAINMENT v4 — CURRENT PHYSICAL CONFIDENCE values (design v4
+// §2). A derived DISPLAY status, never stored, never the enum.
+export const CONTAINMENT_STOP_CONFIDENCES = Object.freeze([
+  "not_applicable", "verified_current", "verified_recorded",
+  "contested", "unverified", "unknown",
+]);
+
+// Derive the CURRENT PHYSICAL CONFIDENCE of a chain stop from
+// (a) the stored stop record (a readContainmentState result) and
+// (b) a FRESH registration observation supplied by the caller:
+//   fresh = { kind: "value", armed: <number|null> } — the caller
+//     just read getAlarm() and this is what it returned;
+//   fresh = { kind: "failed" } — that read threw;
+//   fresh = { kind: "unavailable" } — the surface cannot read
+//     the registration (stored record alone).
+// Strength discipline (design v4 §2.3's truth table is the proof
+// artifact; this function is its mechanical form):
+//   * "verified_current" requires BOTH a stop action's recorded
+//     verification AND a fresh null observation in THIS call —
+//     never either alone;
+//   * a fresh NON-NULL observation under CHAIN_STOPPED is
+//     "contested" whatever the record says: physical reality
+//     outranks the record, and the record — including the
+//     last-successful-verification fact — is left untouched
+//     beside it (the derivation writes nothing);
+//   * a failed fresh read is "unknown", never better;
+//   * with no fresh observation the strongest claim is
+//     "verified_recorded": the record's word, dated by
+//     stopVerifiedAt, not re-confirmed;
+//   * an unverified record whose last ACTION failed after an
+//     earlier success is "unknown" (the failure is the latest
+//     action evidence), while one that never succeeded is
+//     "unverified" — even when a fresh read shows no
+//     registration, because no stop action has ever confirmed
+//     one.
+// The enum is never downgraded by this function and never
+// upgraded either: it returns a display status only.
+export function deriveStopConfidence(read, fresh) {
+  if (!read || !read.verified || !read.known) return "unknown";
+  if (read.state !== "CHAIN_STOPPED") return "not_applicable";
+  const f = fresh && typeof fresh === "object"
+    ? fresh : { kind: "unavailable" };
+  if (f.kind === "failed") return "unknown";
+  if (f.kind === "value") {
+    if (typeof f.armed === "number") return "contested";
+    if (f.armed !== null) return "unknown";
+    // A fresh null observation in this very derivation.
+    if (read.stopStatus === "verified" ||
+        read.stopStatus === "re_verified")
+      return "verified_current";
+    if (read.stopStatus === "unverified" &&
+        typeof read.stopVerifiedAt === "number")
+      return "unknown";
+    return "unverified";
+  }
+  // No fresh observation: the stored record alone, at its
+  // own strength.
+  if (read.stopStatus === "verified" ||
+      read.stopStatus === "re_verified")
+    return "verified_recorded";
+  if (read.stopStatus === "unverified" &&
+      typeof read.stopVerifiedAt === "number")
+    return "unknown";
+  if (read.stopStatus === "unverified" || read.stopStatus === null)
+    return "unverified";
+  return "unknown";
+}
