        "name": "OPALREADER_STORAGE",
        "type": "r2_bucket"
      },
      {
        "name": "OPALREADER_GENERATION",
        "queue_name": "opalreader-generation",
        "type": "queue"
      },
      {
        "name": "ALLOWED_ORIGIN",
