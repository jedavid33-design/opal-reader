    "method": "PUT",
    "path": "/accounts/{account_id}/workers/scripts/opalreader-api-v2",
    "query": {
      "bindings_inherit": "strict"
    }
  },
  "metadata": {
    "main_module": "v2/worker-entry.js",
    "compatibility_date": "2026-08-29",
